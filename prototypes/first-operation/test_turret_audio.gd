extends SceneTree
const Sound=preload("res://turret_audio.gd")
func _initialize(): call_deferred("run")
func run():
	assert(Sound.safe_load("res://nonexistent.mp3")==null)
	assert(Sound.safe_load("res://trex.gd")==null)
	Sound.preload_bank()
	for key in ["fire","up","down"]:
		assert(Sound.bank[key]!=null,"Missing sample "+key)
		assert(not Sound.bank[key].stereo,"Positional sample must be mono")
	var original=Sound.bank.fire;Sound.preload_bank();assert(Sound.bank.fire==original,"Preload must be cached")
	assert(original.loop_mode==AudioStreamWAV.LOOP_FORWARD)
	assert(is_equal_approx(Sound.bank.up.get_length(),1.7))
	assert(is_equal_approx(Sound.bank.down.get_length(),3.2))
	assert(original.save_to_wav("user://turret-audio-test.wav")==OK)
	assert(Sound.safe_load("user://turret-audio-test.wav")!=null,"WAV load failed")
	DirAccess.remove_absolute("user://turret-audio-test.wav")
	var player=Sound.new();root.add_child(player)
	player.update(.1,true,false,.1);assert(player.starts.up==1 and player.starts.fire==0)
	for i in 120: player.update(1.0/60,true,true,2.5)
	assert(player.starts.fire==1 and player.starts.up==1,"Held trigger restarted samples")
	assert(player.firing.pitch_scale==1 and player.firing.max_polyphony==1)
	player.update(.1,false,false,2.4)
	assert(not player.firing.playing and player.starts.down==1)
	player.update(.1,false,false,2.2);assert(player.starts.down==1,"Release whine repeated")
	player.update(.1,true,true,2.3);assert(player.starts.fire==2 and not player.motor.playing,"Hot re-trigger kept release whine")
	player.silence();assert(not player.firing.playing and not player.motor.playing)
	print("PASS: MP3/WAV loading, missing-file safety, cached mono splices, continuous firing, spool edges, release and retrigger")
	quit()
